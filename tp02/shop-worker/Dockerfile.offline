# syntax=docker/dockerfile:1.10
# Bonus B1 : build sans réseau.
# 1) avec réseau :  docker buildx build -f Dockerfile.offline --target prefetch --secret id=pipconf,src=pip.conf -o type=cacheonly .
# 2) sans réseau :  docker buildx build -f Dockerfile.offline --network=none -t worker:offline --load .

FROM python:3.12.7-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

# télécharge les wheels dans un cache mount (seule étape qui a besoin du réseau)
FROM base AS prefetch
ARG TARGETARCH
COPY requirements.txt requirements-dev.txt ./
RUN --mount=type=secret,id=pipconf,target=/etc/pip.conf \
    --mount=type=cache,target=/wheels,id=wheels-${TARGETARCH} \
    pip download --dest /wheels -r requirements-dev.txt

FROM base AS builder
ARG TARGETARCH
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements.txt .
RUN --network=none \
    --mount=type=cache,target=/wheels,id=wheels-${TARGETARCH},readonly \
    pip install --no-cache-dir --no-index --find-links /wheels -r requirements.txt

FROM builder AS test
ARG TARGETARCH
COPY requirements-dev.txt .
RUN --network=none \
    --mount=type=cache,target=/wheels,id=wheels-${TARGETARCH},readonly \
    pip install --no-cache-dir --no-index --find-links /wheels -r requirements-dev.txt
COPY worker ./worker
COPY tests ./tests
RUN ruff check worker tests && python -m pytest -q tests

FROM base AS runtime
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin worker
COPY --from=builder /opt/venv /opt/venv
COPY --from=test /app/worker ./worker
ENV PATH=/opt/venv/bin:$PATH
USER worker
EXPOSE 9100
CMD ["python", "-m", "worker.main"]
