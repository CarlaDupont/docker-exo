# syntax=docker/dockerfile:1.10
# Bonus B3 : uv au lieu de pip.
# build : UV_INDEX_URL=https://pypi.org/simple docker build --secret id=uv_index,env=UV_INDEX_URL -f Dockerfile.uv -t worker:uv .

FROM ghcr.io/astral-sh/uv:0.4.30 AS uv

FROM python:3.12.7-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

FROM base AS builder
ARG TARGETARCH
COPY --from=uv /uv /usr/local/bin/uv
# copie au lieu de liens durs : le cache et le venv ne sont pas sur le même système de fichiers
ENV UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN uv venv /opt/venv
COPY requirements.txt .
# l'URL de l'index (avec identifiants) est lue depuis le secret, seulement pendant ce RUN
RUN --mount=type=secret,id=uv_index \
    --mount=type=cache,target=/root/.cache/uv,id=uv-${TARGETARCH} \
    UV_INDEX_URL="$(cat /run/secrets/uv_index)" uv pip install -r requirements.txt

FROM builder AS test
ARG TARGETARCH
COPY requirements-dev.txt .
RUN --mount=type=secret,id=uv_index \
    --mount=type=cache,target=/root/.cache/uv,id=uv-${TARGETARCH} \
    UV_INDEX_URL="$(cat /run/secrets/uv_index)" uv pip install -r requirements-dev.txt
COPY worker ./worker
COPY tests ./tests
RUN ruff check worker tests && python -m pytest -q tests

FROM base AS runtime
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin worker
COPY --from=builder /opt/venv /opt/venv
COPY --from=test /app/worker ./worker
ENV PATH=/opt/venv/bin:$PATH
USER worker
EXPOSE 9100
CMD ["python", "-m", "worker.main"]
